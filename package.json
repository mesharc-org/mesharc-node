{
  "name": "mesharc",
  "version": "0.1.2",
  "description": "Node client for the MeshArc API: a URL in, clean content out, and a record of what changed.",
  "keywords": [
    "scraping",
    "crawler",
    "web-data",
    "change-detection",
    "sitemap",
    "markdown",
    "llm"
  ],
  "homepage": "https://mesharc.dev/docs/sdks",
  "bugs": {
    "url": "https://github.com/Siddharth-DWT/mesharc-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Siddharth-DWT/mesharc-node"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
